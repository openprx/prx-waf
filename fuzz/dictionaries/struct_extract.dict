# libFuzzer dictionary for the structured-body extractor.
# Tokens that let the mutator build deeply nested / guard-boundary documents
# cheaply; without these it essentially never reaches the depth caps
# (MAX_PARSE_INPUT_DEPTH = 64, MAX_GRAPHQL_RAW_OPENS = 256).
open_brace="{"
open_bracket="["
open_paren="("
close_brace="}"
close_bracket="]"
close_paren=")"
nest_brace_8="{{{{{{{{"
nest_bracket_8="[[[[[[[["
nest_paren_8="(((((((("
unnest_brace_8="}}}}}}}}"
unnest_bracket_8="]]]]]]]]"
unnest_paren_8="))))))))"
json_obj="{\"a\":"
json_key="\"a\":"
nosql_ne="{\"$ne\":null}"
nosql_where="{\"$where\":"
nosql_gt="\"$gt\""
nosql_regex="\"$regex\""
json_unicode="\\u0027"
gql_query="query{"
gql_arg="a(x:"
gql_var="query($n:String)"
gql_fragment="fragment F on T{"
gql_block_string="\"\"\""
gql_comment="#"
gql_spread="...F"
xml_open="<a>"
xml_close="</a>"
xml_doctype="<!DOCTYPE r ["
xml_entity="<!ENTITY x SYSTEM \"file:///etc/passwd\">"
xml_cdata="<![CDATA["
xml_pi="<?xml version=\"1.0\"?>"
xml_charref="&#x27;"
xml_amp="&amp;"
mp_boundary="--fuzzbound"
mp_end="--fuzzbound--"
mp_disp="Content-Disposition: form-data; name=\"a\""
mp_filename="; filename=\"../../etc/passwd\""
mp_ctype="Content-Type: text/plain"
crlf="\x0d\x0a"
bom_le="\xff\xfe"
bom_be="\xfe\xff"
sqli="' OR '1'='1"
sqli_union=" UNION SELECT "
