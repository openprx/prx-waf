# libFuzzer dictionary for the ModSecurity SecRule parser
# (waf_engine::rules::formats::modsec::parse). Tokens are the directive,
# variable, operator and action keywords the parser branches on in
# modsec.rs — the mutator otherwise has to spell "SecRule " and "@rx " byte
# by byte before it ever exercises split_secrule_parts/parse_operator.
directive="SecRule "
op_rx="@rx "
op_contains="@contains "
op_begins="@beginsWith "
op_ends="@endsWith "
op_ip="@ipMatch "
var_args="ARGS"
var_headers="REQUEST_HEADERS"
var_uri="REQUEST_URI"
var_body="REQUEST_BODY"
var_method="REQUEST_METHOD"
act_id="id:"
act_phase="phase:"
act_status="status:"
act_msg="msg:"
act_severity="severity:"
act_deny="deny"
act_pass="pass"
act_log="log"
act_block="block"
act_redirect="redirect"
act_allow="allow"
comma=","
dquote="\""
squote="'"
comment="#"
continuation="\\\x0a"
sqli_marker="UNION SELECT"
xss_marker="<script>"
traversal_marker="../"
