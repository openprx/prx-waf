sqli_or="' OR 1=1-- -"
sqli_sleep="AND SLEEP(5)"
sqli_hex="0x31204f52"
sqli_concat="CONCAT(CHAR("
sqli_info="information_schema.tables"
xss_img="<img src=x onerror=alert(1)>"
xss_svg="<svg/onload=alert(1)>"
xss_js_uri="javascript:alert(1)"
xss_expr="expression("
xss_style="<style>@import"
lfi="../../../../etc/passwd"
lfi_null="%00.png"
rfi="http://evil.example.com/shell.txt?"
rce_semi=";cat /etc/passwd"
rce_backtick="`id`"
rce_shellshock="() { :;}; /bin/bash"
php_open="<?php "
php_system="system($_REQUEST["
java_jndi="${jndi:ldap://"
java_ognl="%24%7B"
webshell="<%eval request(\"cmd\")%>"
crlf="%0d%0aSet-Cookie:"
nullbyte="%00"
double_enc="%252e%252e%252f"
utf8_overlong="%c0%ae"
