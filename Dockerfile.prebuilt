# Development image for a binary you compiled yourself: COPY below takes
# target/release/prx-waf straight from the working tree, so this base image has
# to satisfy whatever glibc your *host* toolchain linked against, not the other
# way round. glibc guarantees backward compatibility only.
#
# bookworm ships glibc 2.36 and any build on a current Debian/Ubuntu host needs
# more than that: a release binary built here on trixie (glibc 2.41) pulls in
# fmod, fmodf, __isoc23_sscanf and __isoc23_strtol at GLIBC_2.38, and running it
# under debian:bookworm-slim dies before main with "version `GLIBC_2.38' not
# found (required by ...)" against both libc.so.6 and libm.so.6. That made the
# documented local-dev path — docker-compose.build.yml, and all four services in
# docker-compose.cluster.yml — unrunnable on the machines most likely to use it;
# docker-compose.firedrill.yml had already worked around it by forking its own
# trixie copy of this file rather than fixing it here.
#
# trixie-slim is the same base Dockerfile.release uses, for the mirror-image
# reason: it has to tolerate the glibc of the CI runner that produced the
# artifact. Raise this in step with the oldest host you expect to build on.
FROM debian:trixie-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY target/release/prx-waf /usr/local/bin/prx-waf
COPY configs/   /app/configs/
COPY rules/     /app/rules/
COPY data/      /app/data/
COPY web/admin-ui/dist /app/web/admin-ui/dist
COPY migrations/ /app/migrations/

RUN chmod +x /usr/local/bin/prx-waf

EXPOSE 80 443 9527

# Kept, unlike in Dockerfile.release. That file dropped the instruction because
# a *published* image cannot carry it — buildkit exports OCI media types and the
# OCI image config only reserves the `Healthcheck` key without defining it. This
# image is never published: a classic `docker build` writes a Docker-format
# config that does carry the field, so `docker run` of this image self-reports
# health with no extra flags.
#
# podman is the exception. Its default output is OCI and it discards the
# instruction out loud ("HEALTHCHECK is not supported for OCI image format and
# will be ignored"); `podman build --format docker` keeps it. Nothing is lost
# there either, because every compose file that builds this Dockerfile —
# docker-compose.build.yml layered over docker-compose.yml, and all three nodes
# in docker-compose.cluster.yml — declares its own service-level healthcheck
# against the same /health endpoint.
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:9527/health || exit 1

CMD ["/usr/local/bin/prx-waf", "--config", "/app/configs/default.toml", "run"]
